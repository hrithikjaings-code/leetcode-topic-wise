LC: https://leetcode.com/problems/number-of-ways-to-assign-edge-weights-ii/description/

class Solution {
public:
    int n, l, mod;
    vector<vector<int>> adj;

    int timer,d;
    vector<int> tin, tout;
    vector<vector<int>> up;
    vector<int> depth;

    void dfs(int v, int p)
    {
        tin[v] = ++timer;
        up[v][0] = p;
        depth[v] = d++;
        for (int i = 1; i <= l; ++i)
            up[v][i] = up[up[v][i-1]][i-1];

        for (int u : adj[v]) {
            if (u != p)
                dfs(u, v);
        }

        tout[v] = ++timer;
        d--;
    }

    bool is_ancestor(int u, int v)
    {
        return tin[u] <= tin[v] && tout[u] >= tout[v];
    }

    int lca(int u, int v)
    {
        if (is_ancestor(u, v))
            return u;
        if (is_ancestor(v, u))
            return v;
        for (int i = l; i >= 0; --i) {
            if (!is_ancestor(up[u][i], v))
                u = up[u][i];
        }
        return up[u][0];
    }

    vector<int> assignEdgeWeights(vector<vector<int>>& edges, vector<vector<int>>& queries) {
        n = edges.size() + 1,mod = 1e9 + 7;
        tin.resize(n + 1);
        tout.resize(n + 1);
        depth.resize(n + 1);
        timer = 0;
        l = ceil(log2(n + 1));
        d = 1;
        up.assign(n + 1, vector<int>(l + 1));

        adj.assign(n + 1, {});

        for (auto &e : edges) {
            int u = e[0], v = e[1];
            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        dfs(1, 1);

        vector<vector<int>> dp(n + 2,vector<int>(2,0));
        dp[1][0] = 1;
        dp[1][1] = 1;
        for(int i = 2;i <= n;i++){
            dp[i][0] = dp[i][1] = (dp[i - 1][1] + dp[i - 1][0])%mod;
        }
        vector<int> ans;
        for(auto x: queries){
            int u = x[0],v = x[1];
            int lc = lca(u, v);
            int val = dp[depth[u] + depth[v] - 2 * depth[lc]][1];
            ans.push_back(val);
        }
        return ans;


    }
};
